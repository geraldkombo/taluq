{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_22", "pnpm", "openssl"]
        },
        "install": {
          "cmds": ["pnpm install --frozen-lockfile"]
        },
        "build": {
          "cmds": ["cd apps/web && npx prisma generate", "pnpm --filter web build"]
        }
      },
      "start": {
        "cmd": "cd apps/web && pnpm start"
      }
    },
    "watchPatterns": [
      "apps/**",
      "packages/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/webhook/paystack",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
